{
  "manifest_version": 3,
  "name": "HAR Capture Suite",
  "version": "0.5.2",
  "description": "HAR Capture Suite v0.5.2 \u2014 captcha-safe (Turnstile/CF not broken by debugger)",
  "permissions": [
    "debugger",
    "tabs",
    "storage",
    "webNavigation",
    "alarms",
    "scripting",
    "cookies",
    "webRequest"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content-captcha.js"
      ],
      "run_at": "document_start",
      "exclude_matches": [
        "*://challenges.cloudflare.com/*",
        "*://*.challenges.cloudflare.com/*",
        "*://*.hcaptcha.com/*",
        "*://*.recaptcha.net/*",
        "*://www.google.com/recaptcha/*",
        "*://www.gstatic.com/recaptcha/*",
        "*://*.funcaptcha.com/*",
        "*://*.arkoselabs.com/*"
      ],
      "all_frames": false
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content-js-capture.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "exclude_matches": [
        "*://challenges.cloudflare.com/*",
        "*://*.challenges.cloudflare.com/*",
        "*://*.hcaptcha.com/*",
        "*://*.recaptcha.net/*",
        "*://www.google.com/recaptcha/*",
        "*://www.gstatic.com/recaptcha/*",
        "*://*.funcaptcha.com/*",
        "*://*.arkoselabs.com/*"
      ],
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "content-captcha.js",
        "content-js-capture.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "HAR Capture"
  }
}
